{
  "manifest_version": 3,
  "name": "Listen Together",
  "version": "3.10.5",
  "description": "Listen to the same song at the same time with friends on the web players of Apple Music, Spotify, YouTube Music and YouTube, even across different services.",
  "permissions": [
    "scripting",
    "storage",
    "offscreen",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://music.apple.com/*",
    "https://open.spotify.com/*",
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://pc-status-relay.onrender.com/*",
    "https://itunes.apple.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "match.js",
        "apple.js",
        "lyrics.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "match.js",
        "spotify.js",
        "lyrics.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "match.js",
        "ytm.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "match.js",
        "youtube.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.apple.com/*",
        "https://open.spotify.com/*",
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.apple.com/*",
        "https://open.spotify.com/*"
      ],
      "js": [
        "lyrics_relay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pc-status-relay.onrender.com/listen/*"
      ],
      "js": [
        "listen.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Listen Together",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
